# OMR Pipeline configuration
# Copy this file to ".env" and fill in values for your machine.
# .env is gitignored — your local paths and secrets won't be committed.
#
# All paths are optional.  When a variable is not set, env_loader.py
# falls back to a sensible default relative to the project root.
#
# Project layout for reference (defaults shown):
#     <project>/
#         src/        — source modules
#         scripts/    — entry-point CLIs
#         api/        — REST API + clients
#         training/   — model-training scripts
#         models/     — trained weights        <- $MODELS_DIR
#         data/
#             input/      — input score PNGs     <- $INPUT_DIR
#             sample/     — dummy-API fixtures   <- $SAMPLE_DATA_DIR
#         output/     — pipeline outputs       <- $OUTPUT_BASE_DIR
#         docs/       — markdown documentation <- $DOCS_DIR
#         archive/    — legacy / test outputs  <- $ARCHIVE_DIR


# ─── Folder roots (override if your data lives elsewhere) ────────────
# MODELS_DIR=S:\omr\models
# DATA_DIR=S:\omr\data
# INPUT_DIR=S:\omr\data\input
# SAMPLE_DATA_DIR=S:\omr\data\sample
# OUTPUT_BASE_DIR=S:\omr\output


# ─── Trained model files (overrides MODELS_DIR-based defaults) ───────
# YOLO symbol-detection model
# MODEL_PATH=S:\omr\models\deepscores_crops_v1.pt

# OLA pretrained staff bounding-box model (fallback in staff_detector_yolo)
# OLA_MODEL_PATH=S:\omr\models\ola_v2.pt

# Trained U-Net staff-segmentation model (used by staff_detector_unet)
# UNET_MODEL_PATH=S:\omr\models\staff_unet.pth


# ─── API server (only used when running api/real_api.py) ─────────────
HOST=0.0.0.0
PORT=5000
MAX_IMAGE_MB=50


# ─── Dummy API fixtures (only used by api/dummy_api.py) ──────────────
# DUMMY_RECTIFIED_PATH=S:\omr\data\sample\rectified.png
# DUMMY_XML_PATH=S:\omr\data\sample\score.xml
# DUMMY_DETECTIONS_PATH=S:\omr\data\sample\detections.json
