# OMR Pipeline configuration
# Copy this file to ".env" and fill in values for your machine.
# .env is gitignored — your local paths and secrets won't be committed.

# ─── Model paths ──────────────────────────────────────────────────────
# YOLO symbol detection model
MODEL_PATH=S:\omr\models\deepscores_crops_v1.pt

# OLA pretrained staff bbox model (optional — used by staff_detector_yolo)
OLA_MODEL_PATH=S:\omr\models\ola_v2.pt

# Trained U-Net staff segmentation model (optional — used by staff_detector_unet)
UNET_MODEL_PATH=S:\omr\models\staff_unet.pth

# ─── API server ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000
MAX_IMAGE_MB=50

# Where the real_api.py writes per-job output folders
OUTPUT_BASE_DIR=S:\omr\api_outputs

# ─── Dummy API fixtures (only used when running dummy_api.py) ────────
DUMMY_RECTIFIED_PATH=S:\omr\sample_data\rectified.png
DUMMY_XML_PATH=S:\omr\sample_data\score.xml
DUMMY_DETECTIONS_PATH=S:\omr\sample_data\detections.json
